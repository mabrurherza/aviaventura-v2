---
import Layout from "../../layouts/Layout.astro";
import NewsfeedItem from "../../components/NewsfeedItem.astro";
import LogoOutlineGraphic from "../../components/LogoOutlineGraphic.astro";

import { sanityClient } from "sanity:client";
const newsData = await sanityClient.fetch(`*[_type == "news"]`);

import { urlFor } from "../../sanity/lib/urlFor";
---

<Layout>
  <main class="overflow-hidden">
    <header
      class="container mx-auto flex items-center pt-32 lg:pt-40 relative px-5"
    >
      <div class="flex-1 z-10">
        <h1 class="text-display text-5xl">Newsfeed</h1>
        <p>
          Stay informed with the latest updates from AVIAVENTURA. <br />Discover
          our latest airline partnerships, events, and industry insights, and
          more.
        </p>
      </div>
      <div
        class="flex-1 h-full absolute md:relative md:flex left-80 md:left-0 w-[320px] md:w-full z-0 top-0 justify-end"
      >
        <LogoOutlineGraphic />
      </div>
    </header>

    <section class="container mx-auto py-24 space-y-5 px-5">
      <div class="flex flex-col gap-20">
        {
          newsData.map((news: any) => (
            <NewsfeedItem
              title={news.title}
              excerpt={news.excerpt}
              thumbnail={urlFor(news.thumbnail)}
              slug={news.slug.current}
            />
          ))
        }
      </div>
    </section>
  </main>
</Layout>
